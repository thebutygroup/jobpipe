# jobpipe environment. Copy to .env and fill in.
# STACK RULES (from your infra notes): save as ASCII, no BOM. Do NOT put the
# characters hash or dollar inside any VALUE. Keep comments on their own lines.
# Create it on Windows with:
#   Set-Content -Path .env -Encoding ascii -Value (Get-Content .env.example)
# then edit values.

ANTHROPIC_API_KEY=
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993

# Aggregator API sources. Leave blank to keep the source unconfigured (it
# no-ops with a log line and shows 'unconfigured' on /sources).
# Reed: register at reed.co.uk/developers/jobseeker (instant key)
REED_API_KEY=
# Adzuna: register at developer.adzuna.com (app id + key; free tier ~250 calls/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Safety margin under Adzuna's free-tier limit
ADZUNA_DAILY_CALL_CAP=100

DB_PATH=/app/data/jobpipe.db
MATCH_THRESHOLD=7
MATCH_DAILY_CALL_CAP=200
TZ=Europe/London
POLL_COOLDOWN_DAYS=5

# v1 submission. Leave SUBMIT_ENABLED=false until you have watched it prepare
# real applications and confirmed the answers look right.
SUBMIT_ENABLED=false
MAX_SUBMISSIONS_PER_DAY=10
SUBMIT_MIN_INTERVAL_S=300
COMPANY_COOLDOWN_DAYS=30
CAPTCHA_RESOLVER=human
TWOCAPTCHA_API_KEY=

# CSRF signing for the review forms. Generate an ASCII value with no hash or
# dollar characters, e.g. a hex string from: python -c "import secrets;print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=
DASHBOARD_BASE_URL=https://jobs.example.com
# hostname Django should accept (your public dashboard domain)
DASHBOARD_HOST=jobs.example.com
